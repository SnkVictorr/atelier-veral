# Configuração do Servidor de E-mail Zoho Mail — Atelier Veral
# Copie este arquivo para ".env" e preencha os valores abaixo quando registrar o domínio na Zoho.
# Enquanto estas variáveis estiverem vazias ou o arquivo .env não existir,
# o servidor registrará os pedidos no terminal e mostrará a confirmação na tela sem enviar e-mail real.

SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=contato@atelierveral.com.br

# Porta do servidor web local (opcional, padrão 3000)
PORT=3000
